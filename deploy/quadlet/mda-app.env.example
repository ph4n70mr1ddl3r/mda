# Secrets for the mda-app container (chmod 600; DO NOT commit a real one).
# Install at /etc/mda/mda-app.env (rootful) or ~/.config/mda/mda-app.env (rootless).

# Non-superuser role the app serves as (created by migrations/20260111000001_rls.sql).
# Set a strong password out-of-band: ALTER ROLE mda_app PASSWORD '...';
MDA_APP_DATABASE_URL=postgres://mda_app:CHANGE_ME@mda-postgres:5432/mda

# REQUIRED in release — generate with: openssl rand -hex 32
MDA_JWT_SECRET=CHANGE_ME_to_a_32_plus_byte_random_secret_value

# Optional: values for the SecretStore (§5.20) — webhook signing keys,
# connector credentials. A JSON object mapping ref → value; the container
# needs it mounted (see mda-app.container) and referenced here. Values are
# resolved server-side only and never returned by any API.
# MDA_SECRET_FILE=/run/secrets/mda-secrets.json

# Optional: per-tenant/per-user CORS allow-list (comma-separated origins).
# MDA_CORS_ORIGINS=https://app.example.com
