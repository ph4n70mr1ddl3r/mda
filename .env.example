# Example environment for local development. Copy to `.env` and adjust.
# `.env` is gitignored; this file is tracked.

# PostgreSQL (matches docker-compose.yml; port 5433 avoids colliding with a
# host-installed Postgres on 5432 during local dev)
DATABASE_URL=postgres://mda:mda@localhost:5433/mda

# The non-superuser role the app serves requests as, so biz.* RLS engages
# (the `mda` owner above bypasses RLS and is used only for migrations). The
# `mda_app` role + grants are created by migrations/20260111000001_rls.sql.
# REQUIRED in release; in debug its absence only warns.
# MDA_APP_DATABASE_URL=postgres://mda_app:mda@localhost:5433/mda

# Redis (cache / sessions / pub-sub; not used until later phases)
REDIS_URL=redis://127.0.0.1:6379

# Server bind
MDA_HOST=0.0.0.0
MDA_PORT=8080

# Pool size
MDA_DB_MAX_CONNECTIONS=10

# Logs: "pretty" (dev) or "json" (prod). RUST_LOG overrides the default filter.
LOG_FORMAT=pretty
# RUST_LOG=info,mda=debug,sqlx=warn

# ===== Production edge knobs (all optional; safe defaults) =====
# JWT secret. REQUIRED in release — and by `docker compose --profile app up`
# / `make up-staging` (the app image is a release build). In debug a dev
# default is used (with a warning). Generate with: openssl rand -hex 32
# MDA_JWT_SECRET=

# CORS: comma-separated allowed origins for browser clients. Empty →
# permissive in debug (dev), same-origin only in release.
# MDA_CORS_ORIGINS=https://app.example.com

# Max request body size in bytes (covers JSON + uploads; raise for large bulk
# imports). Default 10 MiB.
# MDA_MAX_BODY_BYTES=10485760

# Login brute-force defence (per-account progressive lockout + per-IP limit,
# shared across instances via Postgres). Defaults: 5 attempts within a 900s
# window → 900s lockout.
# MDA_LOGIN_MAX_FAILS=5
# MDA_LOGIN_WINDOW_SECS=900
# MDA_LOGIN_LOCKOUT_SECS=900

# Honor X-Forwarded-For / X-Real-IP for the per-IP lockout ONLY behind a proxy
# that overwrites them (they are client-spoofable otherwise; default: ignore
# them and use the socket peer).
# MDA_TRUST_PROXY=1

# TTL (seconds) of the one-shot SSE ticket issued by /api/auth/event-ticket
# (browser EventSource can't set headers, so it uses ?ticket=<short-lived>
# instead of putting the access JWT in the URL). Default 60.
# MDA_TICKET_TTL_SECS=60

# ===== Secrets store (§5.20) =====
# `sys_secret` holds only a REFERENCE; the VALUE is resolved server-side from a
# SecretStore. LocalSecretStore resolves, in order: an env var named exactly the
# secret `ref`, then this JSON file mapping { "<ref>": "<value>" }. Cloud KMS /
# Vault impls are follow-ups (same trait). Values are never returned by any API.
# MDA_SECRET_FILE=/etc/mda/secrets.json

# ===== Blob store (§5.14) =====
# Directory backing LocalBlobStore (attachment bytes). Dev default
# /tmp/mda-blobs; REQUIRED in release (created 0700).
# MDA_BLOB_DIR=/var/lib/mda/blobs

# ===== Outbound egress (connectors / webhooks) =====
# By default the platform refuses to fetch private/reserved targets (SSRF
# guard: RFC1918, loopback, link-local incl. cloud metadata). Set to 1 only for
# on-prem topologies whose connectors legitimately target internal hosts.
# MDA_ALLOW_PRIVATE_EGRESS=1

# ===== Bootstrap admin =====
# Password for the first-run superuser admin@mda.local. Dev default
# admin123 (with a warning); REQUIRED in release (≥ 12 chars) — a known
# default would be a standing root credential.
# MDA_BOOTSTRAP_PASSWORD=change-me-12-plus-chars

# ===== Database roles =====
# When set, startup migrations apply it as the mda_app role's password
# (ALTER ROLE). Keep in sync with MDA_APP_DATABASE_URL above. Lets operators
# rotate the app-role credential without hand-editing the cluster.
# MDA_APP_DB_PASSWORD=mda

# ===== Email transport / SMTP (§5.18) =====
# Outbound email goes through a pluggable MailSender. With MDA_SMTP_HOST set, a
# minimal SMTP relay client (EHLO → MAIL FROM → RCPT TO → DATA → QUIT) delivers
# to the relay; without it, sends are a safe no-op (the message is still
# recorded in sys_message for audit + retries). TLS/SMTP-AUTH/lettre plug in
# behind the same MailSender trait. Default port 25, HELO mda.local,
# From no-reply@mda.local.
# MDA_SMTP_HOST=postfix
# MDA_SMTP_PORT=25
# MDA_SMTP_HELO=mda.local
# MDA_SMTP_FROM=no-reply@example.com

# ===== API versioning & deprecation (§9 / ADR-0022) =====
# The current stable API major (what unpinned requests are served). Default 1.
# MDA_API_VERSION=1
# The oldest major still served; older → 400 mda.unsupported_version. Default 1.
# MDA_MIN_API_VERSION=1
# Comma-separated majors that are served but deprecated (emit Sunset/Deprecation/
# Link headers so SDKs migrate ahead of removal). Empty by default. A future v2
# cutover sets: MDA_API_VERSION=2, MDA_DEPRECATED_VERSIONS=1.
# MDA_DEPRECATED_VERSIONS=
# The Sunset date advertised for deprecated majors (RFC-1123). Default far-future.
# MDA_SUNSET_DATE=Sun, 31 Dec 2099 00:00:00 GMT
# Documentation URL advertised via Link rel="deprecation".
# MDA_DEPRECATION_LINK=https://mda.example.com/docs/api-versioning
