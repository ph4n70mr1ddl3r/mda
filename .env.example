# Example environment for local development. Copy to `.env` and adjust.
# `.env` is gitignored; this file is tracked.

# PostgreSQL (matches docker-compose.yml; port 5433 avoids colliding with a
# host-installed Postgres on 5432 during local dev)
DATABASE_URL=postgres://mda:mda@localhost:5433/mda

# Redis (cache / sessions / pub-sub; not used until later phases)
REDIS_URL=redis://127.0.0.1:6379

# Server bind
MDA_HOST=0.0.0.0
MDA_PORT=8080

# Pool size
MDA_DB_MAX_CONNECTIONS=10

# Logs: "pretty" (dev) or "json" (prod). RUST_LOG overrides the default filter.
LOG_FORMAT=pretty
# RUST_LOG=info,mda=debug,sqlx=warn
